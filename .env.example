# .env.example — copy to .env in the repo root and fill in what you use.
# .env is gitignored: never commit it. Generated from envfile.SECRETS by
# `python envfile.py`; edit the table, not this file.
#
# main.py loads .env on every command; a variable already set in your shell
# wins, and an empty value counts as unset. The workflows read GitHub
# Actions secrets with the same names instead.

# --- Required ---

# Scores each new posting (one Claude call per posting).
# Get it: console.anthropic.com > API Keys > Create Key.
ANTHROPIC_API_KEY=

# The service account that reads and writes the Sheet.
# Get it: Google Cloud console > IAM & Admin > Service Accounts > Keys > Add key (JSON); paste the whole file on one line, in single quotes.
GOOGLE_SERVICE_ACCOUNT_JSON=

# The Sheet every scored posting is logged to.
# Get it: the long ID in the Sheet's URL, between /d/ and /edit; share the Sheet with the service account's client_email as Editor.
GOOGLE_SHEET_ID=

# Sends the digest; also the inbox the optional readers read.
# Get it: the Gmail address the digest is sent from.
GMAIL_ADDRESS=

# The SMTP and IMAP login for GMAIL_ADDRESS (never the account password).
# Get it: myaccount.google.com/apppasswords (needs 2-Step Verification on the account).
GMAIL_APP_PASSWORD=

# --- Optional: each unlocks one source or switch ---

# Unlocks sources.enabled.adzuna: the Adzuna job search API (with ADZUNA_API_KEY).
# Get it: developer.adzuna.com > Dashboard > API Access Details.
ADZUNA_APP_ID=

# Unlocks sources.enabled.adzuna: the Adzuna job search API (with ADZUNA_APP_ID).
# Get it: developer.adzuna.com > Dashboard > API Access Details.
ADZUNA_API_KEY=

# Unlocks sources.enabled.jsearch: the JSearch job search API.
# Get it: rapidapi.com > subscribe to the JSearch API > your app's key.
RAPIDAPI_KEY=

# Unlocks sources.enabled.usajobs: federal postings from the USAJOBS API.
# Get it: developer.usajobs.gov/apirequest, registered to GMAIL_ADDRESS.
USAJOBS_API_KEY=

# Unlocks sources.applied_doc: seeds Applied rows in the Sheet from the jobs listed in that Doc.
# Get it: the ID in your job-index Google Doc's URL, between /d/ and /edit; share the Doc with the service account (Viewer is enough).
GOOGLE_DOC_ID=

# --- Optional ---

# Sends the weekly summary here instead of delivery.email_to.
# Get it: any address.
RECIPIENT_EMAIL=
